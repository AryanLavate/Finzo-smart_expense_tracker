# Backend environment variables (FastAPI)
# Keep real secrets in backend/.env or Render env settings, never in this file.

# Production DB URL (Render usually injects this automatically)
DATABASE_URL=postgresql+psycopg://your_username:your_password@your-postgres-host:5432/your_database

# JWT signing secret (required in production)
SECRET_KEY=your_secret_key_here

# Startup behavior (true/false). Recommended false on production.
AUTO_CREATE_TABLES=false

# Optional SSL override for Postgres URLs (e.g. require, disable, verify-full)
# POSTGRES_SSLMODE=require

# Local fallback DB settings (used only when DATABASE_URL is missing)
# DB_TYPE=sqlite
# SQLITE_PATH=./dev.sqlite
#
# DB_TYPE=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=expense_tracker
# DB_USER=postgres
# DB_PASSWORD=your_db_password_here
