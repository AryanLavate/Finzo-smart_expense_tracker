#
# Production (Render PostgreSQL)
# - Provide `DATABASE_URL` via Render environment variables.
# - TLS/SSL is commonly required; the app will auto-add `sslmode=require`
#   for non-local Postgres hosts, but you can override it with `POSTGRES_SSLMODE`.
#
DATABASE_URL=postgresql+psycopg://your_username:your_password@your-postgres-host:5432/your_database

#
# Local fallback (only used when `DATABASE_URL` is not set)
# Choose one:
#
# DB_TYPE=sqlite
# SQLITE_PATH=./dev.sqlite
#
# DB_TYPE=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=expense_tracker
# DB_USER=postgres
# DB_PASSWORD=
#
# Optional:
# POSTGRES_SSLMODE=require
